#!/bin/sh /etc/rc.common
# =============================================================================
# qmanager-core — OpenWRT Procd Init Script for Go Core Binary
# =============================================================================
# Manages single-binary qmanager-core Go application on OpenWRT devices.
#
# Usage:
#   /etc/init.d/qmanager-core start|stop|restart|enable|disable
#
# Install location: /etc/init.d/qmanager-core
# =============================================================================

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/qmanager-core

start_service() {
    [ -x "$PROG" ] || return 1

    mkdir -p /etc/qmanager
    mkdir -p /var/lock

    procd_open_instance "qmanager-core"
    procd_set_param command "$PROG"
    procd_set_param env PORT=80 TLS_PORT=443 TLS_ENABLED=true
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

stop_service() {
    rm -f /tmp/qmanager_*.lock /tmp/qmanager_*.pid
}

reload_service() {
    stop
    start
}
